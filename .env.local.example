# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings -> API Keys).

# URL do projeto, algo como https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable. Ela vai para o navegador por design — é pública.
# NUNCA coloque aqui a secret/service_role: ela ignora o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexão com o banco, usada só pelos scripts de linha de comando (db:push,
# test:sql). Nunca é lida pela aplicação.
# Project Settings -> Database -> Connection string -> Session pooler.
SUPABASE_DB_URL=
